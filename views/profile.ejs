<%- include('partials/header') %>
<h1>Your profile</h1>
<% if (saved) { %><p class="ok">Saved.</p><% } %>
<p><b>Username:</b> <%= profile.username %></p>
<p><b>Email:</b> <%= profile.email %></p>

<h3>Bio (shown to anyone who views your profile)</h3>
<div class="bio-box">
  <% if (isVulnerable) { %>
    <%- profile.bio %>   <%# VULNERABLE: unescaped output -> stored XSS executes %>
  <% } else { %>
    <%= profile.bio %>   <%# SAFE: escaped output -> payload shown as text %>
  <% } %>
</div>

<form method="post" action="/profile" class="form">
  <label>Edit bio
    <textarea name="bio" rows="3"><%= profile.bio %></textarea>
  </label>
  <button type="submit">Save bio</button>
</form>
<p class="hint">Stored XSS target. Vulnerable-mode payload in the bio:
<code>&lt;script&gt;alert('stored-xss '+document.cookie)&lt;/script&gt;</code></p>
<%- include('partials/footer') %>
