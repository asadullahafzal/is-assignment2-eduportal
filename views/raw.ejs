<%- include('partials/header') %>
<!-- The search route builds `body` as an HTML string. In VULN mode it contains
     the user's query unescaped (reflected XSS); in SAFE mode it is escaped. -->
<form method="get" action="/search" class="form inline-form">
  <input name="q" placeholder="Search pages..." value="">
  <button type="submit">Search</button>
</form>
<%- body %>
<p class="hint">Reflected XSS target. Vulnerable-mode payload in <code>q</code>:
<code>&lt;script&gt;alert(document.domain)&lt;/script&gt;</code></p>
<%- include('partials/footer') %>
