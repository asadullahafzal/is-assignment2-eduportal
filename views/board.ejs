<%- include('partials/header') %>
<h1>Comment board</h1>
<% if (user) { %>
  <form method="post" action="/board" class="form">
    <label>Post a comment <textarea name="body" rows="2"></textarea></label>
    <button type="submit">Post</button>
  </form>
<% } else { %><p class="hint"><a href="/login">Log in</a> to post.</p><% } %>

<ul class="comments">
  <% comments.forEach(function (c) { %>
    <li>
      <b><%= c.author %></b>:
      <% if (isVulnerable) { %>
        <%- c.body %>   <%# VULNERABLE: unescaped -> stored XSS %>
      <% } else { %>
        <%= c.body %>   <%# SAFE: escaped %>
      <% } %>
    </li>
  <% }); %>
</ul>
<%- include('partials/footer') %>
